model:
  default: "gemini-2.5-flash"
  provider: "gemini"
  base_url: "https://generativelanguage.googleapis.com/v1beta"

# Supply image understanding when the main model is text-only. With
# `agent.image_input_mode: auto`, a vision-capable main model sees the pixels
# directly and this auxiliary route is only the fallback. The fallback reads
# GEMINI_API_KEY/GOOGLE_API_KEY from the runtime environment without exposing
# the secret to terminal subprocesses.
auxiliary:
  vision:
    provider: "gemini"
    model: "gemini-2.5-flash"
    timeout: 120
    download_timeout: 30

# Generate images directly through Google with the same Gemini key. The
# provider runs Charlotte's configured image route inside Hermes's trusted
# process, so provider credentials never enter model-authored terminal commands.
image_gen:
  provider: "gemini"
  model: "quality"

# Optional: route delegated subagents through direct xAI/Grok instead of the
# main Gemini model. Requires XAI_API_KEY in the repo-local .env.
# delegation:
#   provider: "xai"
#   model: "grok-4.3"

stt:
  enabled: true
  provider: "local"
  local:
    model: "base"

tts:
  provider: "edge"
  edge:
    voice: "en-US-AriaNeural"

voice:
  record_key: "ctrl+b"
  max_recording_seconds: 120
  auto_tts: true
  beep_enabled: true
  silence_threshold: 200
  silence_duration: 3.0

terminal:
  backend: "local"
  cwd: "/workspace"
  timeout: 180
  docker_mount_cwd_to_workspace: false
  lifetime_seconds: 300

# DDGS is the keyless search backend; it cannot extract pages. The browser
# toolset below supplies keyless page retrieval for research workflows.
web:
  search_backend: ddgs

skills:
  external_dirs:
    - /workspace/skills
  # Charlotte's checked-in skills are authoritative. Do not have background
  # review forks create runtime supplements after workflow runs.
  creation_nudge_interval: 0

curator:
  enabled: false

platform_toolsets:
  cli: [hermes-cli, browser, image_gen, delegation]
  telegram: [terminal, file, web, browser, vision, image_gen, tts, skills, todo, cronjob, delegation]
  discord: [hermes-discord, terminal, file, web, browser, vision, image_gen, tts, skills, todo, cronjob, delegation]

discord:
  require_mention: false

agent:
  max_turns: 60
  image_input_mode: auto
