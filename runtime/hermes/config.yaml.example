model:
  default: "minimax/minimax-m2.7"
  provider: "custom:nanogpt"
  base_url: ""

custom_providers:
  - name: "nanogpt"
    base_url: "https://nano-gpt.com/api/subscription/v1"
    key_env: "NANOGPT_API_KEY"
    model: "minimax/minimax-m2.7"
    api_mode: "chat_completions"

stt:
  enabled: true
  provider: "local"
  local:
    model: "base"

tts:
  provider: "edge"
  edge:
    voice: "en-US-AriaNeural"

voice:
  record_key: "ctrl+b"
  max_recording_seconds: 120
  auto_tts: false
  beep_enabled: true
  silence_threshold: 200
  silence_duration: 3.0

terminal:
  backend: "local"
  cwd: "/workspace"
  timeout: 180
  docker_mount_cwd_to_workspace: false
  lifetime_seconds: 300
  env_passthrough:
    - GEMINI_API_KEY
    - GOOGLE_API_KEY
    - GOOGLE_MAPS_API_KEY
    - XAI_API_KEY
    - XAI_IMAGE_MODEL
    - NANOGPT_API_KEY
    - NANOGPT_IMAGE_MODEL_SUBSCRIPTION
    - NANOGPT_IMAGE_MODEL_GEMINI
    - NANOGPT_IMAGE_MODEL_GROK

# Web search/fetch backend for the `web` toolset. `ddgs` (DuckDuckGo) is
# keyless and installed into the Hermes venv by runtime/hermes/Dockerfile, so
# it works on a fresh clone with no API key. Swap to tavily/brave/exa here if
# you add the corresponding API key to .env.
web:
  search_backend: ddgs

skills:
  external_dirs:
    - /workspace/skills

platform_toolsets:
  cli: [hermes-cli]
  telegram: [terminal, file, web, vision, skills, todo, cronjob]

agent:
  max_turns: 60
