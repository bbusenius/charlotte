# Students registry — copy this file to students.yaml and fill in your own data.
#
# This file is the single source of truth for per-student metadata used by
# skills in this project (materials-builder, tablet-slide-builder,
# mindfeast-weekly-slides, mindfeast-slide-sync, mindfeast-slide-trigger,
# hsd-time-log, hsd-book-log, lesson-plan-builder, field-trip-planner,
# unit-builder, curriculum-builder).
#
# Students are keyed by a lowercase slug. Paid third-party curricula live
# under `curricula/third-party/<curriculum-slug>/` and are shared across
# students; the per-student `curricula` map below records which ones a given
# student is using.
#
# Command-line tools such as signal-sieve and xlsx-append are installed from
# pyproject.toml into the project virtualenv; they are not configured here.
#
# Adding a student:
#   1. Add an entry under `students:` below.
#   2. Put any third-party curriculum markdown under
#      `curricula/third-party/<slug>/<filename>.md` and list that relative
#      path in the student's `curricula` map below.
#   3. Skills that need the metadata will pick it up automatically.

students:
  alice:
    display_name: Alice
    grade: 4
    aliases: [alice]
    tablet_slides_dir: tablet-slides/alice/active
    mindfeast:
      remote_url: http://192.168.1.5:8787
      remote_token: ""
      unlock_requirement:
        default: 1
        no_tablet:
          days: [sunday]
          count: 50
    curricula_dir: curricula/third-party
    curricula:
      level-4-language-arts/Level-4-Language-Arts.md:
        subject: Language Arts & Literature
        lesson_header_pattern: '^##\s+Lesson\s+(?P<number>\d+)'
        lesson_title_on_next_line: false
      math-4/Math-4.md:
        subject: Math
        lesson_header_pattern: '^##\s+Lesson\s+(?P<number>\d+)'
        lesson_title_on_next_line: false
    subjects:
      - Language Arts & Literature
      - Math
      - Science
      - History
      - Handwriting
      - Art
    time_tracking_spreadsheet: ~/Documents/Homeschool/Alice/4th Grade/Time-4.xlsx
    signal_group_alias: alice
    reading:
      signal_group_alias: alice-books
      spreadsheet: ~/Documents/Homeschool/Alice/4th Grade/Reading List-4.xlsx
      read_by_self_sheet_index: 0
      read_to_sheet_index: 1
      default_sheet: read_by_self

  charlie:
    display_name: Charlie
    grade: preschool
    aliases: [charlie, cj]
    tablet_slides_dir: tablet-slides/charlie/active
    mindfeast:
      remote_url: http://192.168.1.5:8787
      remote_token: ""
    curricula_dir: curricula/third-party
    curricula: {}
    subjects:
      - Language Arts
      - Handwriting
      - Math
    time_tracking_spreadsheet: ~/Documents/Homeschool/Charlie/Preschool/Time-P.xlsx
    signal_group_alias: charlie
    reading:
      signal_group_alias: charlie-books
      spreadsheet: ~/Documents/Homeschool/Charlie/Preschool/Reading List-P.xlsx
      read_by_self_sheet_index: 0
      read_to_sheet_index: 1
      default_sheet: read_to

# Default teacher recorded on time-tracking entries (used by hsd-time-log).
# TRANSITIONAL: to be replaced during a future refactor with a value passed
# through from signal-sieve (respecting the message source, including sender
# aliases). Leaving a default here until then.
teacher: Parent
