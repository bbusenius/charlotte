# Students registry — copy this file to students.yaml and fill in your own data.
#
# This file is the single source of truth for per-student metadata used by
# skills in this project (mason-materials-builder, mindfeast-slide-builder,
# mindfeast-weekly-slides, mindfeast-slide-sync, mindfeast-slide-trigger,
# hsd-time-log, hsd-book-log, mason-lesson-plan-builder, mason-field-trip-planner,
# mason-unit-builder, mason-curriculum-builder).
#
# Students are keyed by a lowercase slug. Curriculum content is shared across
# students; the per-student `curricula` map records the concrete entrypoint
# files each student is using. Purchased/imported curricula live under
# `curricula/third-party/`; locally authored curricula may live by subject.
#
# Command-line tools such as signal-sieve and xlsx-append are installed from
# pyproject.toml into the project virtualenv; they are not configured here.
#
# Adding a student:
#   1. Add an entry under `students:` below.
#   2. Put curriculum content under `curricula/` and list its concrete lookup
#      entrypoint file in the student's `curricula` map below.
#   3. Skills that need the metadata will pick it up automatically.

students:
  alice:
    display_name: Alice
    grade: 4
    aliases: [alice]
    tablet_slides_dir: tablet-slides/alice/active
    mindfeast:
      remote_url: http://192.0.2.10:8787
      remote_token: ""
      unlock_requirement:
        default: 1
        no_tablet:
          days: [sunday]
          count: 50
    curricula_dir: curricula
    curricula:
      third-party/example-publisher/language-arts-level-4/curriculum.md:
        subject: Language Arts & Literature
      third-party/example-publisher/math-level-4/course-index.md:
        subject: Math
      art/ao-picture-study/curriculum.md:
        id: ao-picture-study
        aliases: [AO, picture study, AmblesideOnline picture study]
        subject: Art
      music/ao-composer-study/curriculum.md:
        id: ao-composer-study
        aliases: [AO composer study, composer study, AmblesideOnline composer study]
        subject: Music
    subjects:
      - Language Arts & Literature
      - Math
      - Science
      - History
      - Handwriting
      - Art
    time_tracking_spreadsheet: ~/Documents/Homeschool/Alice/4th Grade/Time-4.xlsx
    # How lesson material reaches Charlotte for this student. Optional — a
    # student with no `inbox` has no queue, and you simply tell Charlotte what
    # was covered in conversation instead.
    #
    # A queue is worth configuring because the queue name itself says which
    # workflow and which student the material belongs to. Charlotte does not
    # have to infer any of that, your messages can be terse, and scheduled
    # unattended runs are safe.
    #
    #   kind:  which adapter reads the queue. "signal" uses signal-sieve.
    #   queue: the queue name as that adapter knows it. For kind: signal this
    #          is the signal-sieve group alias (case-sensitive), exactly as it
    #          appears in `signal-sieve groups`.
    inbox:
      kind: signal
      queue: alice
    reading:
      # Books go in their own queue, separate from lessons.
      inbox:
        kind: signal
        queue: alice-books
      spreadsheet: ~/Documents/Homeschool/Alice/4th Grade/Reading List-4.xlsx
      read_by_self_sheet_index: 0
      read_to_sheet_index: 1
      default_sheet: read_by_self

  charlie:
    display_name: Charlie
    grade: preschool
    aliases: [charlie, cj]
    tablet_slides_dir: tablet-slides/charlie/active
    mindfeast:
      remote_url: http://192.0.2.10:8787
      remote_token: ""
    curricula_dir: curricula
    curricula: {}
    subjects:
      - Language Arts
      - Handwriting
      - Math
    time_tracking_spreadsheet: ~/Documents/Homeschool/Charlie/Preschool/Time-P.xlsx
    # No `inbox` here on purpose: Charlie has no queue, so his lessons and
    # books are logged from what you tell Charlotte in conversation. That is a
    # normal configuration — see docs/ingest-contract.md. Mixing the two styles
    # across students in one family is fine.
    reading:
      spreadsheet: ~/Documents/Homeschool/Charlie/Preschool/Reading List-P.xlsx
      read_by_self_sheet_index: 0
      read_to_sheet_index: 1
      default_sheet: read_to

# Fallback teacher name written into a lesson log when the source material has
# no sender alias. hsd-time-log later projects that value into the time workbook.
teacher: Parent
