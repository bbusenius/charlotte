# Copy to .env and fill in local secrets. Do not commit .env.

# Optional direct Google/Gemini image-generation key used by the google route
# in scripts/charlotte_image.py.
GEMINI_API_KEY=

# Optional direct xAI/Grok key used by xAI routes and integrations.
XAI_API_KEY=
XAI_IMAGE_MODEL=

# Optional Google Maps key for runtimes that expose Google Maps tools or MCP.
GOOGLE_MAPS_API_KEY=

# NanoGPT key used by the Hermes runtime model driver and optional capability
# routes in runtime.yaml.
NANOGPT_API_KEY=
# NanoGPT image model IDs are not secrets. Choose IDs from NanoGPT's image
# model catalog that are available to your account/subscription.
NANOGPT_IMAGE_MODEL_SUBSCRIPTION=
NANOGPT_IMAGE_MODEL_GEMINI=
NANOGPT_IMAGE_MODEL_GROK=

# Optional Docker home-relative data mounts. Entries are colon-separated and
# mounted under the Hermes terminal HOME, `/opt/data/home`, so host ~/... paths
# keep working inside agent-run commands. They are also mounted under `/opt/data`
# for explicit profile/MCP paths. For example, if students.yaml points to
# Homeschool-Dashboard-compatible records under ~/Documents/Homeschool, use:
# CHARLOTTE_HOME_MOUNTS=Documents/Homeschool
# If a Hermes MCP server command points at a local checkout outside this repo,
# add that home-relative path here too, then use /opt/data/<that-path> in the
# Hermes MCP config.

# Container timezone. Leave blank to auto-detect from the host (via timedatectl,
# /etc/timezone, or the /etc/localtime symlink). Set explicitly if auto-detection
# is wrong or the host lacks timedatectl, e.g. CHARLOTTE_TZ=America/Chicago.
CHARLOTTE_TZ=

# Local Charlotte info page (plain HTTP on the LAN). runtime/hermes/run.sh
# serves a small static page and prints a QR so a tablet on the same network can
# open it. Leave CHARLOTTE_INFO_HOST blank to use the current LAN IP detected at
# startup. Set CHARLOTTE_INFO_PAGE=0 to disable serving it.
CHARLOTTE_INFO_PAGE=1
CHARLOTTE_INFO_HOST=
CHARLOTTE_INFO_PORT=8788

# Hermes Telegram gateway. Create TELEGRAM_BOT_TOKEN with BotFather.
# TELEGRAM_ALLOWED_USERS is a comma-separated list of numeric Telegram user IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
