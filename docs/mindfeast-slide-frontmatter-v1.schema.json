{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mindfeast-slide-frontmatter-v1.schema.json",
  "title": "MindFeast Slide Frontmatter v1",
  "description": "Schema for the YAML frontmatter mapping in a version 1 MindFeast slide package. Version 1 labels the specification; slide packages do not carry a format-version field.",
  "type": "object",
  "required": ["id", "type"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "enum": ["question", "informational", "essay", "gratitude", "narration", "conversation"]
    },
    "subject": {
      "type": "string"
    },
    "image": {
      "$ref": "#/$defs/filename"
    },
    "audio": {
      "$ref": "#/$defs/filename"
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "accept": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "difficulty": {
      "type": "string",
      "default": "easy"
    },
    "orientation": {
      "enum": ["landscape", "portrait"],
      "default": "landscape"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "question"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": ["answer"],
        "anyOf": [
          {
            "required": ["image"]
          },
          {
            "required": ["audio"]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": ["essay", "gratitude"]
          }
        },
        "required": ["type"]
      },
      "then": {
        "anyOf": [
          {
            "required": ["image"]
          },
          {
            "required": ["audio"]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "narration"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "audio": {
            "$ref": "#/$defs/sourceFilename"
          },
          "script": {
            "$ref": "#/$defs/sourceFilename"
          },
          "passage": {
            "$ref": "#/$defs/sourceFilename"
          }
        },
        "oneOf": [
          {
            "required": ["audio"]
          },
          {
            "required": ["script"]
          },
          {
            "required": ["passage"]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "conversation"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": ["intent", "turns", "context"],
        "properties": {
          "intent": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "turns": {
            "type": "integer",
            "minimum": 1
          },
          "context": {
            "$ref": "#/$defs/sourceFilename"
          }
        }
      }
    }
  ],
  "$defs": {
    "filename": {
      "type": "string",
      "minLength": 1,
      "description": "A basename for a file stored directly in the slide directory."
    },
    "sourceFilename": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}$)(?=.*\\S)[^/\\\\]+$",
      "description": "A non-blank basename for a narration or conversation source file, without path separators."
    }
  }
}
